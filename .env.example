# --- Forester Lead Engine ---------------------------------------------------
# Alleen het inkoopformulier stuurt nog een lead; bezichtigingen lopen via
# bellen, WhatsApp of mail. Lead, notificatie naar Leroy en de Postmark-
# bevestiging naar de inzender lopen via Forester. Zolang FORESTER_WEBSITE_ID
# leeg is, logt de site de lead alleen server-side (niets gaat verloren, maar
# er gaat ook geen mail).
FORESTER_WEBSITE_ID=
FORESTER_LEAD_ENGINE_INKOOP=
FORESTER_LEAD_ENGINE_COATING=
